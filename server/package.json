{
  "name": "@desk-tools/caa-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:bundle": "node scripts/build-server-bundle.mjs",
    "build:native": "node scripts/build-native-tools.mjs",
    "build:tauri-runtime": "pnpm build:native && pnpm smoke:real-fcstd && pnpm build:bundle && pnpm smoke:bundle && pnpm prepare:tauri-runtime && pnpm smoke:tauri-runtime",
    "dev": "tsx watch src/server.ts",
    "measure:kt-codegen": "tsx scripts/measure-kt-codegen.ts",
    "prepare:tauri-runtime": "node scripts/prepare-tauri-runtime.mjs",
    "smoke:bundle": "node scripts/smoke-server-bundle.mjs",
    "smoke:real-fcstd": "node scripts/smoke-real-fcstd.mjs",
    "smoke:tauri-runtime": "node scripts/smoke-tauri-runtime.mjs",
    "smoke:tauri-release-app": "node scripts/smoke-tauri-release-app.mjs",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@desk-tools/catdlg-core": "workspace:*",
    "@hono/node-server": "^1.13.8",
    "@phoenix-wing/code-core": "0.4.3",
    "@phoenix-wing/cad-contracts": "0.4.3",
    "@phoenix-wing/cad-core": "0.4.3",
    "@phoenix-wing/db-node": "0.4.3",
    "@phoenix-wing/kt-codegen": "0.4.3",
    "@phoenix-wing/workspace-schema": "0.4.3",
    "fflate": "0.8.3",
    "hono": "^4.7.4",
    "iconv-lite": "0.6.3",
    "node-sqlite3-wasm": "^0.8.59"
  },
  "devDependencies": {
    "@phoenix-wing/cad-rust-source": "0.4.3",
    "@types/node": "^26.0.1",
    "@vitest/ui": "^4.1.10",
    "esbuild": "0.25.12",
    "tsx": "^4.19.3",
    "typescript": "~5.7.2",
    "vitest": "^4.1.9"
  }
}
