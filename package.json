{
  "name": "phoenix-desk-tools",
  "private": true,
  "description": "Phoenix 桌面辅助工具 — 根目录 pnpm 命令转发至 web-ui",
  "scripts": {
    "dev": "concurrently -n ui,caa -c blue,green \"pnpm dev:ui\" \"pnpm dev:caa\"",
    "dev:ui": "pnpm -C web-ui dev",
    "dev:caa": "pnpm -C server/caa dev",
    "build": "pnpm -C web-ui build",
    "preview": "pnpm -C web-ui preview",
    "test:py:caa": "python -m unittest tests.test_caa_index -v",
    "test:core": "pnpm -C packages/catdlg-core test",
    "test:web": "pnpm -C web-ui test",
    "test:caa": "pnpm run test:py:caa && pnpm run test:core && pnpm run test:web"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531",
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
